{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/server.js",
    "dev:full": "concurrently \"pnpm dev\" \"pnpm dev:server\"",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "predeploy": "pnpm build",
    "deploy": "gh-pages -d dist",
    "start": "node server/server.js",
    "hash-password": "node -e \"import('bcryptjs').then(({default:bcrypt}) => bcrypt.hash(process.argv[1], 12).then(console.log))\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.4",
    "motion": "12.23.24",
    "nodemailer": "^9.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.13.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "^10.0.3",
    "gh-pages": "^6.3.0",
    "tailwindcss": "4.1.12",
    "typescript": "^6.0.3",
    "vite": "6.3.5"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  }
}
