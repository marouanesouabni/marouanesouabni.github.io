# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/portfolio
JWT_SECRET=replace-with-a-long-random-secret

# Private dashboard account
ADMIN_EMAIL=sbnmarouan@gmail.com
# Generate this value with: pnpm hash-password "your-long-password"
ADMIN_PASSWORD_HASH=$2a$12$replace-with-the-generated-bcrypt-hash

# SMTP provider (Brevo, Resend SMTP, Gmail App Password, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=Portfolio <your-smtp-username>
CONTACT_TO_EMAIL=sbnmarouan@gmail.com
